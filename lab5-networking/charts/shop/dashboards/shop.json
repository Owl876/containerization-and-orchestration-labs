{
  "uid": "shop-lab3",
  "title": "Shop \u2014 Lab 3",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "shop",
    "lab3"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "namespace",
        "type": "textbox",
        "query": "shop",
        "current": {
          "text": "shop",
          "value": "shop"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Available replicas",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"$namespace\",deployment=~\"shop-(api|worker)\"}",
          "refId": "A",
          "legendFormat": "{{deployment}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Business requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (service) (rate(shop_http_requests_total{namespace=\"$namespace\",component=\"api\",path=~\"/order|/orders\"}[2m]))",
          "refId": "A",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Business HTTP 5xx rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum(rate(shop_http_requests_total{namespace=\"$namespace\",status=~\"5..\",path!=\"/health\"}[2m])) or vector(0)) / clamp_min(sum(rate(shop_http_requests_total{namespace=\"$namespace\",path!=\"/health\"}[2m])), 0.001)",
          "refId": "A",
          "legendFormat": "Business HTTP 5xx rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Processed orders per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(shop_orders_processed_total{namespace=\"$namespace\"}[2m]))",
          "refId": "A",
          "legendFormat": "Processed orders per second"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Pending orders",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(shop_orders_pending{namespace=\"$namespace\"})",
          "refId": "A",
          "legendFormat": "Pending orders"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Worker last successful poll, seconds ago",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - max(shop_worker_last_success_timestamp_seconds{namespace=\"$namespace\",service=\"shop-worker\"} > 0)",
          "refId": "A",
          "legendFormat": "last successful poll"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "API p95 latency, seconds",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(shop_http_request_duration_seconds_bucket{namespace=\"$namespace\",component=\"api\",path!=\"/health\"}[2m])))",
          "refId": "A",
          "legendFormat": "API p95 latency, seconds"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Shop alerts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "ALERTS{namespace=\"$namespace\",alertname=~\"Shop.*\",alertstate=\"firing\"}",
          "refId": "A",
          "legendFormat": "{{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
